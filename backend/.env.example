# Copy to .env and fill in. Every value has a working dev default in auth.py's
# Settings, so the app runs without a .env — only needed to change behavior.

# JWT signing key. The code ships an insecure default for local dev — set a
# real random value (e.g. `openssl rand -hex 32`) before deploying.
SECRET_KEY=

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where the Google OAuth callback redirects after issuing a token.
FRONTEND_URL=http://localhost:3000

# Copy to .env and fill in. Every value has a working dev default in
# config.py's Settings, so the app runs without a .env — only needed to
# change behavior.

# JWT signing key. The code ships an insecure default for local dev — set a
# real random value (e.g. `openssl rand -hex 32`) before deploying.
SECRET_KEY=

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where the Google OAuth callback redirects after issuing a token, and the
# only origin the API's CORS policy allows.
FRONTEND_URL=http://localhost:3000

# Defaults to a local SQLite file next to the backend source. Point this at
# a Postgres URL to switch databases — no ORM code changes needed. Leave
# commented out (not just blank) to keep the default — an empty value here
# would override it with an invalid, empty connection string.
# DATABASE_URL=

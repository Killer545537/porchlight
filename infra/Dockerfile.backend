# Porchlight API — bundles the assignment SQLite DB as-is (no seed on startup).
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./
COPY backend/middleware ./middleware
COPY backend/models ./models
COPY backend/routers ./routers
COPY backend/domain ./domain
COPY backend/auth.py backend/config.py backend/database.py backend/main.py backend/scripts.py backend/seed.py ./

RUN uv sync --frozen --no-dev

# Exact assignment database — copied verbatim, not regenerated by seed.py.
COPY infra/data/porchlight.db /app/porchlight.db.seed
RUN mkdir -p /app/static/uploads

COPY infra/entrypoint-backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV DATABASE_URL=sqlite:////data/porchlight.db
ENV FRONTEND_URL=http://localhost:3000

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
